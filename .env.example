# ============================================
# Beam Affiliate Platform - Environment
# ============================================

NODE_ENV="development"

# ============================================
# Database
# ============================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/beam"

# ============================================
# Authentication
# Generate with: openssl rand -base64 32
# ============================================
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-long"

# ============================================
# Application URLs
# Local development defaults
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Test environment URLs
FRONTEND_URL="https://test.beamaffiliate.com"
ADMIN_URL="https://test.beamaffiliate.com/admin"
DASHBOARD_URL="https://test.beamaffiliate.com/dashboard"
API_BASE_URL="https://api-test.beamaffiliate.com"
HEALTH_CHECK_URL="https://api-test.beamaffiliate.com/health"
AUTH_URL="https://api-test.beamaffiliate.com/api/auth"
PAYMENT_URL="https://api-test.beamaffiliate.com/api/payments"
COMMISSION_URL="https://api-test.beamaffiliate.com/api/commissions"
SUPPORT_EMAIL="support@beamaffiliate.com"
DOCUMENTATION_URL="https://docs.beamaffiliate.com"
COMMUNITY_URL="https://community.beamaffiliate.com"

# ============================================
# Email - Resend
# ============================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Beam <noreply@beam.com>"
ADMIN_EMAILS="admin@yourdomain.com,support@yourdomain.com"

# ============================================
# Stripe
# ============================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================
# Beam Wallet / Bank Validation
# ============================================
BEAM_WALLET_API_URL="https://api.beamwallet.com/v1"
BEAM_WALLET_API_KEY="your_beam_wallet_api_key"
BEAM_WALLET_MERCHANT_ID="your_beam_merchant_id"
BEAM_WEBHOOK_SECRET="your_beam_webhook_secret"
BANK_WEBHOOK_SECRET="your_bank_webhook_secret"

# ============================================
# Bank Transfer Instructions
# ============================================
BANK_ACCOUNT_NAME="Beam Technologies Ltd"
BANK_IBAN="IE29 AIBK 9311 5212 3456 78"
BANK_BIC="AIBKIE2D"

# ============================================
# Notifications / Automation
# ============================================
PUSH_PROVIDER_URL=""
CRON_SECRET="your_cron_secret"
